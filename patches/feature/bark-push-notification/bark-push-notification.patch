+  cronJobFailed: 'agent_cron_job_failed',
+  cronJobFailedPaused: 'agent_cron_job_failed_paused',
+  imageGenerationCompleted: 'image_generation_completed',
+  interventionRequired: 'agent_intervention_required',
+  videoGenerationCompleted: 'video_generation_completed',
+} as const;
