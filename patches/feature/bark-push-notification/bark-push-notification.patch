+import { notifyUser } from '../notification';
+import { NOTIFICATION_CATEGORY, NOTIFICATION_TYPE } from '../notification/categories';
+import { renderCopy } from '../notification/copy';
+import { buildConversationPath, previewText } from '../notification/format';
+
 export interface NotifyScheduledTaskCompletedParams {
   /** Agent executing the task — lets inbox surfaces render its avatar. */
   agentId?: string;
@@ -33,10 +38,66 @@ export interface NotifyScheduledTaskFailedParams {
   workspaceId?: string;
 }
 
+/** Task names are free text — cap them before they land in a push payload. */
+const jobName = (params: { taskIdentifier: string; taskName?: string }) =>
+  previewText(params.taskName, params.taskIdentifier, 80);
+
+/**
+ * A scheduled tick landed. `taskLifecycle` only calls this for genuine
+ * scheduled runs, so a manual "run now" run stays silent.
+ *
+ * This is the task side of the pair; the chat side is
+ * `notifyAgentRunCompleted`. A task run carries the task runner's own trigger,
+ * which `CompletionLifecycle` does not recall, so an operation never reaches
+ * both slots.
+ */
 export async function notifyScheduledTaskCompleted(
-  _params: NotifyScheduledTaskCompletedParams,
-): Promise<void> {}
+  params: NotifyScheduledTaskCompletedParams,
+): Promise<void> {
+  await notifyUser({
+    actionUrl: buildConversationPath({ agentId: params.agentId, topicId: params.topicId }),
+    category: NOTIFICATION_CATEGORY.schedule,
+    content: renderCopy('agent_cron_job_completed', { jobName: jobName(params) }),
+    context: previewText(params.lastAssistantContent, '', 120) || undefined,
+    dedupeKey: `scheduled_task_completed:${params.operationId}`,
+    metadata: params.agentId ? { agent: { id: params.agentId } } : undefined,
+    title: renderCopy('agent_cron_job_completed_title'),
+    type: NOTIFICATION_TYPE.cronJobCompleted,
+    userId: params.userId,
+    workspaceId: params.workspaceId,
+  });
+}
 
+/**
+ * A scheduled tick failed. `taskLifecycle` fires this for heartbeat ticks too,
+ * but only once the failure fuse trips and pauses the task — an ordinary
+ * heartbeat failure is expected to be transient and stays silent.
+ */
 export async function notifyScheduledTaskFailed(
-  _params: NotifyScheduledTaskFailedParams,
-): Promise<void> {}
+  params: NotifyScheduledTaskFailedParams,
+): Promise<void> {
+  await notifyUser({
+    actionUrl: buildConversationPath({ agentId: params.agentId, topicId: params.topicId }),
+    category: NOTIFICATION_CATEGORY.schedule,
+    // The canonical copy already carries the job name. The structured error
+    // code rides along as context so the phone shows *why* without the raw
+    // error text — that stays in briefs/logs.
+    content: params.paused
+      ? renderCopy('agent_cron_job_failed_paused', {
+          count: String(params.consecutiveFailures ?? 1),
+          jobName: jobName(params),
+        })
+      : renderCopy('agent_cron_job_failed', { jobName: jobName(params) }),
+    context: params.errorCode,
+    dedupeKey: `scheduled_task_failed:${params.operationId}`,
+    metadata: params.agentId ? { agent: { id: params.agentId } } : undefined,
+    title: renderCopy(
+      params.paused ? 'agent_cron_job_failed_paused_title' : 'agent_cron_job_failed_title',
+    ),
+    // A fuse-stop is its own scenario: the user has to re-arm the task by hand,
+    // which is a different action from simply retrying a failed tick.
+    type: params.paused ? NOTIFICATION_TYPE.cronJobFailedPaused : NOTIFICATION_TYPE.cronJobFailed,
+    userId: params.userId,
+    workspaceId: params.workspaceId,
+  });
+}
