@@ -0,0 +1,112 @@
+// @vitest-environment node
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+
+import {
+  buildConversationPath,
+  buildPublicUrl,
+  clampText,
+  previewText,
+  stripMarkdown,
+} from '@/business/server/notification/format';
+
+const { mockAppUrl } = vi.hoisted(() => ({
+  mockAppUrl: { value: undefined as string | undefined },
+}));
+
+vi.mock('@/envs/app', () => ({ getAppConfig: () => ({ APP_URL: mockAppUrl.value }) }));
+
+describe('clampText', () => {
+  it('is undefined for blank input', () => {
+    expect(clampText(undefined, 10)).toBeUndefined();
+    expect(clampText('   ', 10)).toBeUndefined();
+  });
+
+  it('caps the text and marks the truncation', () => {
+    expect(clampText('abcdefghij', 5)).toBe('abcd…');
+    expect(clampText('abcde', 5)).toBe('abcde');
+  });
+});
+
+describe('previewText', () => {
+  it('falls back when there is nothing to preview', () => {
+    expect(previewText(undefined, 'fallback')).toBe('fallback');
+    expect(previewText('   \n  ', 'fallback')).toBe('fallback');
+  });
+
+  it('collapses whitespace', () => {
+    expect(previewText('line one\n\nline   two', 'fallback')).toBe('line one line two');
+  });
+
+  it('caps the preview and marks the truncation', () => {
+    expect(previewText('abcdefghij', 'fallback', 5)).toBe('abcd…');
+    expect(previewText('abcde', 'fallback', 5)).toBe('abcde');
+  });
+});
+
+describe('buildConversationPath', () => {
+  it('builds the agent conversation path', () => {
+    expect(buildConversationPath({ agentId: 'a1', topicId: 't1' })).toBe('/agent/a1/t1');
+  });
+
+  it('is undefined without both ids', () => {
+    expect(buildConversationPath({ agentId: 'a1' })).toBeUndefined();
+    expect(buildConversationPath({ topicId: 't1' })).toBeUndefined();
+    expect(buildConversationPath({})).toBeUndefined();
+  });
+
+  it('escapes ids so a crafted id cannot redirect the deep link', () => {
+    expect(buildConversationPath({ agentId: '../../etc', topicId: 't1' })).toBe(
+      '/agent/..%2F..%2Fetc/t1',
+    );
+  });
+});
+
+describe('buildPublicUrl', () => {
+  beforeEach(() => {
+    mockAppUrl.value = undefined;
+  });
+
+  it('has no link to offer when there is no usable origin', () => {
+    expect(buildPublicUrl('/agent/a1/t1')).toBeUndefined();
+  });
+
+  it('refuses a loopback origin — a localhost link is a dead tap on a phone', () => {
+    mockAppUrl.value = 'http://localhost:3210';
+    expect(buildPublicUrl('/agent/a1/t1')).toBeUndefined();
+  });
+
+  it('prefixes the origin and trims its trailing slash', () => {
+    mockAppUrl.value = 'https://app.example.com/';
+    expect(buildPublicUrl('/agent/a1/t1')).toBe('https://app.example.com/agent/a1/t1');
+  });
+
+  it('is undefined without a path', () => {
+    expect(buildPublicUrl(undefined)).toBeUndefined();
+  });
+});
+
+describe('stripMarkdown', () => {
+  it('leaves plain text alone', () => {
+    expect(stripMarkdown('Just a sentence.')).toBe('Just a sentence.');
+  });
+
+  it('drops emphasis markers but keeps the words', () => {
+    expect(stripMarkdown('**bold** and `code` and ~~gone~~')).toBe('bold and code and gone');
+  });
+
+  it('drops heading, list and quote markers', () => {
+    expect(stripMarkdown('## Title\n- one\n- two\n> quoted')).toBe('Title one two quoted');
+  });
+
+  it('keeps a link label and drops its url', () => {
+    expect(stripMarkdown('see [the docs](https://example.com/a)')).toBe('see the docs');
+  });
+
+  it('unwraps a fenced code block into a line', () => {
+    expect(stripMarkdown('before\n```ts\nconst a = 1;\n```\nafter')).toBe('before after');
+  });
+
