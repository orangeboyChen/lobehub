+// @vitest-environment node
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+
+import { NotificationModel } from '@/database/models/notification';
+
+const {
+  mockAppUrl,
+  mockCreate,
+  mockCreateDelivery,
+  mockGetAgentAvatarsByIds,
+  mockGetPreference,
+  mockGetUserSettings,
+  mockGetServerDB,
+} = vi.hoisted(() => ({
+  mockAppUrl: { value: undefined as string | undefined },
+  mockCreate: vi.fn(),
+  mockCreateDelivery: vi.fn(),
+  mockGetAgentAvatarsByIds: vi.fn(),
+  mockGetPreference: vi.fn(),
+  mockGetServerDB: vi.fn(),
+  mockGetUserSettings: vi.fn(),
+}));
+
+vi.mock('@/envs/app', () => ({ getAppConfig: () => ({ APP_URL: mockAppUrl.value }) }));
+
+vi.mock('@/database/core/db-adaptor', () => ({ getServerDB: mockGetServerDB }));
+
+vi.mock('@/database/models/notification', () => ({
+  NotificationModel: vi.fn(function () {
+    return { create: mockCreate, createDelivery: mockCreateDelivery };
+  }),
+}));
+
+vi.mock('@/database/models/user', () => ({
+  UserModel: vi.fn(function () {
+    return { getUserSettings: mockGetUserSettings };
+  }),
+}));
+
+vi.mock('@/database/models/agent', () => ({
+  AgentModel: vi.fn(function () {
+    return { getAgentAvatarsByIds: mockGetAgentAvatarsByIds };
+  }),
+}));
+
+vi.mock('@/database/models/workspaceUserSettings', () => ({
+  WorkspaceUserSettingsModel: vi.fn(function () {
+    return { getPreference: mockGetPreference };
+  }),
+}));
+
+const load = () => import('@/business/server/notification/index');
+
+const BARK_ENV_KEYS = ['BARK_KEY', 'BARK_SERVER_URL', 'BARK_USER_ID'];
+
+const okResponse = () => ({
+  json: vi.fn().mockResolvedValue({ code: 200, timestamp: 1700 }),
+  ok: true,
+});
+
+const baseParams = {
+  category: 'agent',
+  content: 'Here is your summary.',
+  context: 'T-1',
+  dedupeKey: 'agent_run_completed:op-1',
+  metadata: { agent: { id: 'a1' } },
+  title: 'Agent run finished',
+  type: 'agent_run_completed',
+  userId: 'u1',
+};
+
+describe('notifyUser', () => {
+  beforeEach(() => {
+    vi.clearAllMocks();
+    for (const key of BARK_ENV_KEYS) delete process.env[key];
+    mockAppUrl.value = undefined;
+    mockGetServerDB.mockResolvedValue({});
+    mockGetUserSettings.mockResolvedValue(undefined);
+    mockGetPreference.mockResolvedValue({});
+    mockGetAgentAvatarsByIds.mockResolvedValue([]);
+    mockCreate.mockResolvedValue({ id: 'n1' });
+    mockCreateDelivery.mockResolvedValue({ id: 'd1' });
+    vi.spyOn(console, 'error').mockImplementation(() => {});
+    vi.spyOn(console, 'warn').mockImplementation(() => {});
+  });
+
+  afterEach(() => {
+    vi.unstubAllGlobals();
+    vi.restoreAllMocks();
+  });
+
+  it('persists the inbox row even when push is unconfigured', async () => {
+    const { notifyUser } = await load();
+
+    await notifyUser({ ...baseParams, actionUrl: '/agent/a1/t1', workspaceId: 'w1' });
+
+    expect(mockCreate).toHaveBeenCalledWith(
+      expect.objectContaining({
+        actionUrl: '/agent/a1/t1',
+        category: 'agent',
+        content: 'Here is your summary.',
+        context: 'T-1',
+        dedupeKey: 'agent_run_completed:op-1',
+        metadata: { agent: { id: 'a1' } },
+        title: 'Agent run finished',
+        type: 'agent_run_completed',
+        workspaceId: 'w1',
+      }),
+    );
+    expect(mockCreateDelivery).not.toHaveBeenCalled();
+  });
+
+  it('scopes the row to the notified user', async () => {
+    const { notifyUser } = await load();
+
+    await notifyUser(baseParams);
+
+    // The model folds its userId into every read and write, so writing through
+    // the wrong id would strand the row outside its owner's inbox.
+    expect(NotificationModel).toHaveBeenCalledWith(expect.anything(), 'u1');
+  });
+
+  it('keeps a notification without a workspace out of every workspace inbox', async () => {
+    const { notifyUser } = await load();
+
+    await notifyUser(baseParams);
+
+    expect(mockCreate).toHaveBeenCalledWith(expect.objectContaining({ workspaceId: null }));
+  });
+
+  it('pushes and records a delivered delivery row', async () => {
