@@ -0,0 +1,28 @@
+import debug from 'debug';
+
+import { getNotificationConfig } from '@/envs/notification';
+
+const log = debug('lobe-notification');
+
+type PushConfig = Partial<ReturnType<typeof getNotificationConfig>>;
+
+/**
+ * Push configuration that never throws.
+ *
+ * A malformed `BARK_*` value makes `createEnv` reject. Most reads happen inside
+ * `notifyUser`, after the inbox row is durable, so a rejection there only costs
+ * the push. `notifyAgentRunCompleted` reads the config *before* the row exists,
+ * and the run lifecycle swallows slot errors — a typo would therefore drop
+ * every notification with no visible cause. Degrade to "unconfigured": the
+ * inbox still works, and the operator sees the reason under
+ * `DEBUG=lobe-notification`.
+ */
+export const pushConfig = (): PushConfig => {
+  try {
+    return getNotificationConfig();
+  } catch (error) {
+    log('invalid BARK_* configuration — treating push as unconfigured: %O', error);
+
+    return {};
+  }
+};
diff --git a/packages/business-server/src/notification/copy.ts b/packages/business-server/src/notification/copy.ts
new file mode 100644
index 0000000000..14cccfcbfc
--- /dev/null
+++ b/packages/business-server/src/notification/copy.ts
@@ -0,0 +1,20 @@
+import notificationCopy from '@/locales/default/notification';
+
+type CopyKey = keyof typeof notificationCopy;
+
+/**
+ * Server-side notification copy.
+ *
+ * The inbox and Cloud render the same strings from the `notification` locale
+ * namespace, so a self-hosted push reuses them instead of inventing a parallel
+ * set that would drift. Only the default (en-US) copy is read: the server has
+ * no per-user locale at notification time.
+ */
+export const renderCopy = (key: CopyKey, values: Record<string, string | undefined> = {}): string =>
+  notificationCopy[key].replaceAll(/\{\{(\w+)\}\}/g, (_match, name: string) => {
+    const value = values[name]?.trim();
+
+    // Callers always supply every placeholder; this only keeps a missed one
+    // from reaching the phone as a raw `{{token}}`.
+    return value ?? '';
+  });
diff --git a/packages/business-server/src/notification/format.ts b/packages/business-server/src/notification/format.ts
new file mode 100644
index 0000000000..ef0a6405ef
--- /dev/null
+++ b/packages/business-server/src/notification/format.ts
@@ -0,0 +1,63 @@
+import { getAppConfig } from '@/envs/app';
+
+/** Hard cap for a single-line field; returns undefined for blank input. */
+export const clampText = (text: string | undefined, maxLength: number): string | undefined => {
+  const collapsed = text?.replaceAll(/\s+/g, ' ').trim();
+
+  if (!collapsed) return undefined;
+  if (collapsed.length <= maxLength) return collapsed;
+
+  return `${collapsed.slice(0, maxLength - 1)}…`;
+};
+
+/** Collapse whitespace so a multi-line reply does not blow up a push payload. */
+export const previewText = (text?: string, fallback = '', maxLength = 200): string =>
+  clampText(text, maxLength) ?? fallback;
+
+/**
+ * Relative SPA path for a conversation.
+ *
+ * Workspace runs would need the workspace slug prefixed to match the URL the
+ * signed-in user sees; without it the bare agent path still resolves, so the
+ * link is emitted as-is rather than guessed at.
+ */
+export const buildConversationPath = (params: {
+  agentId?: string;
+  topicId?: string;
+}): string | undefined => {
+  const { agentId, topicId } = params;
+
+  if (!topicId) return undefined;
+  if (!agentId) return undefined;
+
+  // Encoded: the ids reach here straight off a run payload, and an unescaped
+  // segment would let a crafted id turn the deep link into another path.
+  return `/agent/${encodeURIComponent(agentId)}/${encodeURIComponent(topicId)}`;
+};
+
+/** Hosts that only mean something on the machine that produced them. */
+const LOOPBACK_HOSTS = new Set(['localhost', '127.0.0.1', '[::1]', '::1', '0.0.0.0']);
+
+/**
+ * Absolute URL for an external surface (a push payload).
+ *
+ * Returns undefined when there is no usable origin — including a loopback one,
+ * which `APP_URL` falls back to when it is unset. A `http://localhost:3210/...`
+ * link is a dead tap on a phone (it resolves against the phone itself), so no
+ * link is better than a broken one; the inbox still navigates from the row's
+ * relative path.
+ */
+export const buildPublicUrl = (path: string | undefined): string | undefined => {
+  if (!path) return undefined;
+
+  const origin = getAppConfig().APP_URL?.trim().replaceAll(/\/+$/g, '');
+  if (!origin) return undefined;
+
+  try {
+    if (LOOPBACK_HOSTS.has(new URL(origin).hostname)) return undefined;
+  } catch {
+    return undefined;
+  }
+
+  return `${origin}${path}`;
+};
diff --git a/packages/business-server/src/notification/index.ts b/packages/business-server/src/notification/index.ts
new file mode 100644
index 0000000000..e53ec600b2
--- /dev/null
+++ b/packages/business-server/src/notification/index.ts
@@ -0,0 +1,155 @@
+import type { NotificationMetadata } from '@lobechat/types';
+import debug from 'debug';
+
+import { getServerDB } from '@/database/core/db-adaptor';
+import { NotificationModel } from '@/database/models/notification';
+
+import { resolveAgentPushMeta } from './agentMeta';
+import { isBarkConfigured, isBarkRecipient, sendBarkNotification } from './bark';
+import { buildPublicUrl } from './format';
+import { resolvePresentation } from './levels';
+import { resolvePushEnabled } from './settings';
+
+const log = debug('lobe-notification');
+
+/**
+ * Collapse group for pushes with no resolvable agent.
+ *
+ * Notifications that carry an agent group under that agent's name so its
+ * pushes stack together; the rest still need a key, or Bark would file each of
+ * them separately.
+ */
+const DEFAULT_PUSH_GROUP = 'LobeHub';
+
+/**
+ * One user-visible notification: persisted to the inbox, then pushed to every
+ * enabled channel.
+ *
+ * This is the OSS counterpart of Cloud's `NotificationService`. Every business
+ * slot (`@/business/server/**`) funnels through here so a self-hosted instance
+ * gets inbox rows plus a push without Cloud's channel registry.
+ */
+export interface NotifyUserParams {
+  /** Relative SPA path opened from the inbox and from the push payload. */
+  actionUrl?: string;
+  /** Preference grouping, e.g. `agent`. Keys `push.items`. */
+  category: string;
+  content: string;
+  /** Optional secondary line rendered under the body. */
+  context?: string;
+  /** Skips both the row and the push when an identical key was already sent. */
+  dedupeKey?: string;
+  metadata?: NotificationMetadata;
+  title: string;
+  /** Scenario type, e.g. `completed`. Keys `push.items[category]`. */
+  type: string;
+  userId: string;
+  /** `null` keeps the row personal so it never leaks into a workspace inbox. */
+  workspaceId?: string | null;
+}
+
+export interface NotifyUserOptions {
+  /**
+   * Re-throw a failure to persist the inbox row instead of swallowing it.
+   *
+   * For slots whose caller treats a rejection as fatal and retryable — the
+   * parked intervention path re-queues the whole operation — so silently
+   * absorbing a DB blip would drop the notification with no retry. Delivery
+   * failures are still swallowed either way: they happen after persistence.
+   */
+  fatalOnPersistenceError?: boolean;
+
+  /**
+   * Keep the inbox row but skip the push.
+   *
+   * Slots use this for the one proxy the server has for "the user is probably
+   * still watching" — how long the run took. The desktop client can suppress
+   * its own banner on a focused window; the server cannot see that, so the
+   * floor is a code decision, not a deployment knob.
+   */
+  skipPush?: boolean;
+}
+
+export const notifyUser = async (
+  params: NotifyUserParams,
+  options: NotifyUserOptions = {},
+): Promise<void> => {
+  let persisted = false;
+
+  try {
+    const db = await getServerDB();
+    const model = new NotificationModel(db, params.userId);
+
+    const notification = await model.create({
+      actionUrl: params.actionUrl,
+      category: params.category,
+      content: params.content,
+      context: params.context,
+      dedupeKey: params.dedupeKey,
+      metadata: params.metadata,
+      title: params.title,
+      type: params.type,
+      workspaceId: params.workspaceId ?? null,
+    });
+
+    persisted = true;
+
+    // `null` means the dedupe key already sent this notification — skip it
+    // rather than pushing the same alert twice off a lifecycle retry.
+    if (!notification) return;
+
+    if (options.skipPush) return;
+
+    // Cheap local gates first: on an unconfigured or single-user instance these
+    // answer without the two settings reads below.
+    if (!isBarkConfigured()) {
+      log('no Bark key configured — skipping push');
+      return;
+    }
+
+    // Logged rather than silent: a mistyped BARK_USER_ID otherwise looks exactly
+    // like a broken relay — inbox rows, no pushes, nothing in the log.
+    if (!isBarkRecipient(params.userId)) {
+      log('userId=%s does not own the configured device — skipping push', params.userId);
+      return;
+    }
+
+    if (!(await resolvePushEnabled(db, params))) {
+      log('push muted for userId=%s %s/%s', params.userId, params.category, params.type);
+      return;
+    }
+
+    // The inbox row stores only `metadata.agent.id` and lets a client resolve
+    // the avatar from its live store. A push has no client, so the id is
+    // resolved here: Bark needs a real image URL for the icon, and the agent's
+    // name is what collapses its pushes into one stack on the phone.
+    const agent = await resolveAgentPushMeta(db, params.userId, params.metadata?.agent?.id);
+    const presentation = resolvePresentation(params.category, params.type);
+
+    const result = await sendBarkNotification({
+      body: params.content,
+      call: presentation.call,
+      group: agent.name ?? DEFAULT_PUSH_GROUP,
+      icon: agent.iconUrl,
+      level: presentation.level,
+      // The row's `context` is the secondary line in the inbox; on the phone it
+      // is the subtitle, not a second paragraph of body.
+      subtitle: params.context,
+      title: params.title,
+      url: buildPublicUrl(params.actionUrl),
+    });
+
+    await model.createDelivery({
+      channel: 'push',
+      failedReason: result.failedReason,
+      notificationId: notification.id,
+      providerMessageId: result.providerMessageId,
+      sentAt: new Date(),
+      status: result.status === 'delivered' ? 'delivered' : 'failed',
+    });
+  } catch (error) {
+    if (!persisted && options.fatalOnPersistenceError) throw error;
+
+    console.error('[notification] dispatch failed:', error);
+  }
+};
diff --git a/packages/business-server/src/notification/levels.ts b/packages/business-server/src/notification/levels.ts
new file mode 100644
index 0000000000..3f54f597c3
--- /dev/null
+++ b/packages/business-server/src/notification/levels.ts
@@ -0,0 +1,54 @@
+import { NOTIFICATION_CATEGORY, NOTIFICATION_TYPE } from './categories';
+
+export type BarkLevel = 'active' | 'critical' | 'passive' | 'timeSensitive';
+
+export interface BarkPresentation {
+  /** Bark's `call`: plays the sound repeatedly for 30s. */
+  call?: boolean;
+  level: BarkLevel;
+}
+
+/**
+ * How loudly one scenario should arrive on the phone.
+ *
+ * Bark exposes four interruption levels and they are not decoration — they
+ * decide whether the screen lights up, whether Focus mode is pierced, and
+ * whether silent mode is ignored. Picking one per scenario is the whole point
+ * of having them, so the mapping lives here rather than in config:
+ *
+ * - `critical` — a human has to act now: silent and Do Not Disturb are ignored.
+ * - `timeSensitive` — something broke; surfaces even during Focus.
+ * - `active` — ordinary completion; lights the screen.
+ * - `passive` — lands in the notification list without waking the phone.
+ */
+const PRESENTATION: Record<string, BarkPresentation> = {
+  // A parked intervention is the only case where the run is stopped until a
+  // person answers — ring properly instead of dropping a silent banner.
+  [`${NOTIFICATION_CATEGORY.agent}/${NOTIFICATION_TYPE.interventionRequired}`]: {
+    call: true,
+    level: 'critical',
+  },
+  // The fuse blew and the task is paused: nothing will retry on its own.
+  [`${NOTIFICATION_CATEGORY.schedule}/${NOTIFICATION_TYPE.cronJobFailedPaused}`]: {
+    level: 'critical',
+  },
+  [`${NOTIFICATION_CATEGORY.schedule}/${NOTIFICATION_TYPE.cronJobFailed}`]: {
+    level: 'timeSensitive',
+  },
+  [`${NOTIFICATION_CATEGORY.agent}/${NOTIFICATION_TYPE.agentRunCompleted}`]: { level: 'active' },
+  [`${NOTIFICATION_CATEGORY.schedule}/${NOTIFICATION_TYPE.cronJobCompleted}`]: { level: 'active' },
+  // Generations are something the user is already watching the canvas for; a
+  // phone that lights up adds nothing over the row in the inbox.
+  [`${NOTIFICATION_CATEGORY.generation}/${NOTIFICATION_TYPE.imageGenerationCompleted}`]: {
+    level: 'passive',
+  },
+  [`${NOTIFICATION_CATEGORY.generation}/${NOTIFICATION_TYPE.videoGenerationCompleted}`]: {
+    level: 'passive',
+  },
+};
+
+/** Scenario unknown to this table: show it, but do not make it urgent. */
+const DEFAULT_PRESENTATION: BarkPresentation = { level: 'active' };
+
+export const resolvePresentation = (category: string, type: string): BarkPresentation =>
+  PRESENTATION[`${category}/${type}`] ?? DEFAULT_PRESENTATION;
diff --git a/packages/business-server/src/notification/settings.ts b/packages/business-server/src/notification/settings.ts
new file mode 100644
index 0000000000..5a439718f1
--- /dev/null
+++ b/packages/business-server/src/notification/settings.ts
@@ -0,0 +1,50 @@
+import type { NotificationSettings } from '@lobechat/types';
+import { mergeNotificationSettings } from '@lobechat/utils/mergeNotificationSettings';
+
+import { UserModel } from '@/database/models/user';
+import { WorkspaceUserSettingsModel } from '@/database/models/workspaceUserSettings';
+import type { LobeChatDatabase } from '@/database/type';
+
+/**
+ * The user's effective notification settings: the personal bag with the
+ * workspace-scoped override merged on top, mirroring how the client resolves
+ * `WorkspaceUserPreference` over `UserSettings`.
+ */
+const resolveNotificationSettings = async (
+  db: LobeChatDatabase,
+  userId: string,
+  workspaceId?: string | null,
+): Promise<NotificationSettings> => {
+  const personal = await new UserModel(db, userId).getUserSettings();
+
+  if (!workspaceId) return personal?.notification ?? {};
+
+  const workspacePreference = await new WorkspaceUserSettingsModel(
+    db,
+    userId,
+    workspaceId,
+  ).getPreference();
+
+  return mergeNotificationSettings(
+    personal?.notification ?? {},
+    workspacePreference?.notification ?? {},
+  );
+};
+
+/**
+ * Whether the `push` channel should carry one notification.
+ *
+ * Defaults to enabled: a missing switch means "use the scenario default", so a
+ * user who never opened the settings page still gets recalled. Only an explicit
+ * `false` — the channel master switch, or this scenario's leaf — opts out.
+ */
+export const resolvePushEnabled = async (
+  db: LobeChatDatabase,
+  params: { category: string; type: string; userId: string; workspaceId?: string | null },
+): Promise<boolean> => {
+  const { push } = await resolveNotificationSettings(db, params.userId, params.workspaceId);
+
+  if (push?.enabled === false) return false;
+
+  return push?.items?.[params.category]?.[params.type] !== false;
+};
