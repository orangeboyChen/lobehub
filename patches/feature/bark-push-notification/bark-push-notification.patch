+/**
+ * Recall the user when an interactive run ends with a genuine failure.
+ * Cancellation and parked approval states have their own UI and stay silent.
+ */
+export async function recallUserOnFailure(
+  deps: CompletionLifecycleDeps,
+  operationId: string,
+  event: {
+    agentId?: string;
+    errorAttribution?: ChatMessageErrorAttribution;
+    errorMessage?: string;
+    errorType?: string;
+    topicId?: string;
+  },
+  runOrigin: { trigger?: unknown; userId?: string } | undefined,
+): Promise<void> {
+  const { isChildRun, trigger } = await resolveRunRecallFacts(deps, operationId, runOrigin);
+  if (isChildRun) {
+    log('[%s] Skipping failure push for internal child run', operationId);
+    return;
+  }
+  if (trigger !== undefined && !USER_RECALLABLE_TRIGGERS.has(trigger)) {
+    log('[%s] Skipping failure push for non-interactive trigger %s', operationId, trigger);
+    return;
+  }
+
+  await notifyAgentRunFailed({
+    agentId: event.agentId || undefined,
+    errorAttribution: event.errorAttribution,
+    errorMessage: event.errorMessage,
+    errorType: event.errorType,
+    operationId,
+    topicId: event.topicId,
+    userId: runOrigin?.userId || deps.userId,
+    workspaceId: deps.workspaceId,
+  });
+}
