@@ -0,0 +1,35 @@
+// @vitest-environment node
+import { beforeEach, describe, expect, it } from 'vitest';
+
+const load = () => import('@/business/server/notification/config');
+
+const ENV_KEYS = ['BARK_KEY', 'BARK_SERVER_URL', 'BARK_USER_ID'];
+
+describe('pushConfig', () => {
+  beforeEach(() => {
+    for (const key of ENV_KEYS) delete process.env[key];
+  });
+
+  it('reads a valid configuration', async () => {
+    process.env.BARK_KEY = 'my-key';
+    process.env.BARK_SERVER_URL = 'https://bark.example.com';
+
+    const { pushConfig } = await load();
+
+    expect(pushConfig()).toMatchObject({
+      BARK_KEY: 'my-key',
+      BARK_SERVER_URL: 'https://bark.example.com',
+    });
+  });
+
+  it('reads as unconfigured rather than throwing on an empty environment', async () => {
+    const { pushConfig } = await load();
+
+    // Nothing in the schema can reject any more — level, group and the duration
+    // floor are code decisions now — but the guard stays because a throw here
+    // happens before the inbox row is written, and the run lifecycle swallows
+    // slot errors, so one would silently drop every notification.
+    expect(() => pushConfig()).not.toThrow();
+    expect(pushConfig().BARK_KEY).toBeUndefined();
+  });
+});
