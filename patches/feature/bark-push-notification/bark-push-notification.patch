index 0000000000..f585b67585
--- /dev/null
+++ b/packages/business-server/src/notification/agentMeta.ts
@@ -0,0 +1,89 @@
+import { AgentModel } from '@/database/models/agent';
+import type { LobeChatDatabase } from '@/database/type';
+
+import { buildPublicUrl } from './format';
+
+/**
+ * Everything a push payload needs to know about the agent behind it.
+ *
+ * Inbox rows only carry `metadata.agent.id` because a client resolves the
+ * avatar from its live store (`useNotificationAgentMeta`). A push has no
+ * client: Bark has to be handed a URL, so the row's id is resolved here.
+ */
+export interface AgentPushMeta {
+  /** Absolute image URL, or undefined — Bark cannot use an emoji avatar. */
+  iconUrl?: string;
+  /** Collapse key for Bark's `group`: same agent, one stack on the phone. */
+  name?: string;
+}
+
+const isAbsoluteUrl = (value: string): boolean => {
+  try {
+    const { protocol } = new URL(value);
+
+    return protocol === 'http:' || protocol === 'https:';
+  } catch {
+    return false;
+  }
+};
+
+/**
+ * Formats iOS cannot decode into a notification icon.
+ *
+ * Webp is the one that actually bites: the browser shows it fine, and it is
+ * what the static avatar package ships, but the lock screen renders nothing.
+ */
+const NEEDS_FLATTENING = /\.(?:webp|avif|svg|gif|heic|heif)(?:\?|$)/i;
+
+/**
+ * An image URL APNs can actually fetch and decode, or undefined.
+ *
+ * Agent avatars are free text and three shapes occur: an absolute `https://…`
+ * URL, a **site-relative path** (`/avatars/agent-default.png`, which is what
+ * the packaged default and most shipped agents use), and an emoji. The first two
+ * are sent straight through — a relative one resolved against `APP_URL`, the
+ * same origin and loopback rule the deep link uses, because APNs fetches the
+ * icon from its own network where `http://localhost` resolves to nothing.
+ *
+ * Everything else goes to the avatar endpoint, which flattens it into a png:
+ * a webp converted, an emoji rasterised. That way the push carries the
+ * agent's own mark instead of Bark's.
+ */
+const resolveIconUrl = (avatar: string | null | undefined, agentId: string): string | undefined => {
+  const value = avatar?.trim();
+
+  if (value && !NEEDS_FLATTENING.test(value)) {
+    if (isAbsoluteUrl(value)) return value;
+    if (value.startsWith('/')) return buildPublicUrl(value);
+  }
+
+  return buildPublicUrl(`/webapi/agent/avatar/${encodeURIComponent(agentId)}`);
+};
+
+/**
+ * Resolve the agent behind a notification, never throwing.
+ *
+ * A missing or unreadable agent degrades the push (no icon, no group) — it
+ * must not cost the notification, and it must not cost the caller's run.
+ */
+export const resolveAgentPushMeta = async (
+  db: LobeChatDatabase,
+  userId: string,
+  agentId?: string,
+): Promise<AgentPushMeta> => {
+  if (!agentId) return {};
+
+  try {
+    const [agent] = await new AgentModel(db, userId).getAgentAvatarsByIds([agentId]);
+    if (!agent) return {};
+
+    const label = agent.name || agent.title || undefined;
+
+    return {
+      iconUrl: resolveIconUrl(agent.avatar, agentId),
+      name: label,
+    };
+  } catch {
+    return {};
+  }
+};
