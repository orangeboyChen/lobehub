diff --git a/src/app/(backend)/webapi/agent/avatar/[id]/renderAgentAvatarPng.ts b/src/app/(backend)/webapi/agent/avatar/[id]/renderAgentAvatarPng.ts
new file mode 100644
index 0000000000..4b64fe92a2
--- /dev/null
+++ b/src/app/(backend)/webapi/agent/avatar/[id]/renderAgentAvatarPng.ts
@@ -0,0 +1,103 @@
+import { getAppConfig } from '@/envs/app';
+
+/** Notification icons are small; APNs caps what it will download anyway. */
+const SIZE = 128;
+
+/** A push must not wait on a slow avatar host. */
+const FETCH_TIMEOUT_MS = 5_000;
+
+const CACHE_TTL_MS = 6 * 60 * 60 * 1000;
+const CACHE_MAX_ENTRIES = 256;
+
+/** Per-process cache: one container keeps a hot set; a restart just refills. */
+const cache = new Map<string, { expiresAt: number; png: Buffer }>();
+
+const isHttpUrl = (value: string): boolean => {
+  try {
+    const { protocol } = new URL(value);
+
+    return protocol === 'http:' || protocol === 'https:';
+  } catch {
+    return false;
+  }
+};
+
+const escapeXml = (value: string): string =>
+  value.replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;');
+
+/** Fetch an image and flatten it into a png, which is what iOS can decode. */
+const transcode = async (url: string): Promise<Buffer> => {
+  const response = await fetch(url, { signal: AbortSignal.timeout(FETCH_TIMEOUT_MS) });
+  if (!response.ok) throw new Error(`avatar fetch failed: ${response.status}`);
+
+  const { default: sharp } = await import('sharp');
+
+  return sharp(Buffer.from(await response.arrayBuffer()))
+    .resize(SIZE, SIZE, { fit: 'cover' })
+    .png()
+    .toBuffer();
+};
+
+/** Rasterise an emoji the way the inbox renders one: centred on a plain tile. */
+const renderEmoji = async (emoji: string): Promise<Buffer> => {
+  const { default: sharp } = await import('sharp');
+
+  const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="${SIZE}" height="${SIZE}">
+  <rect width="${SIZE}" height="${SIZE}" rx="28" fill="#f5f5f5" />
+  <text x="50%" y="50%" font-size="78" text-anchor="middle" dominant-baseline="central">${escapeXml(emoji)}</text>
+</svg>`;
+
+  const png = await sharp(Buffer.from(svg)).png().toBuffer();
+  const stats = await sharp(png).stats();
+
+  // Without an emoji font in the image the glyph rasterises to nothing and the
+  // result is a flat rectangle — fall back rather than ship a blank icon.
+  if (stats.channels.every((channel) => channel.min === channel.max))
+    throw new Error('emoji glyph missing from the container fonts');
+
+  return png;
+};
+
+/** The default mark, served from this deployment's own public origin. */
+const defaultAvatar = async (): Promise<Buffer> => {
+  const origin = getAppConfig().APP_URL?.trim().replaceAll(/\/+$/g, '');
+  if (!origin) throw new Error('APP_URL is unset, no default avatar to serve');
+
+  return transcode(`${origin}/avatars/agent-default.png`);
+};
+
+/**
+ * A png for one agent's avatar, whatever shape the stored value has.
+ *
+ * iOS notification icons have to be an image APNs can both fetch and decode:
+ * webp arrives fine in a browser but not on a lock screen, and an emoji has no
+ * URL at all. Both are converted here; a stored png/jpeg is left to the caller
+ * to send directly.
+ */
+export const renderAgentAvatarPng = async (
+  agentId: string,
+  avatar?: string | null,
+): Promise<Buffer> => {
+  const cached = cache.get(agentId);
+  if (cached && cached.expiresAt > Date.now()) return cached.png;
+  if (cached) cache.delete(agentId);
+
+  const value = avatar?.trim();
+
+  let png: Buffer;
+  try {
+    if (value && isHttpUrl(value)) png = await transcode(value);
+    else if (value) png = await renderEmoji(value);
+    else png = await defaultAvatar();
+  } catch {
+    png = await defaultAvatar();
+  }
+
+  if (cache.size >= CACHE_MAX_ENTRIES) {
+    const oldest = cache.keys().next().value;
+    if (oldest) cache.delete(oldest);
+  }
+  cache.set(agentId, { expiresAt: Date.now() + CACHE_TTL_MS, png });
+
+  return png;
+};
diff --git a/src/app/(backend)/webapi/agent/avatar/[id]/route.ts b/src/app/(backend)/webapi/agent/avatar/[id]/route.ts
new file mode 100644
index 0000000000..024f5b99a0
--- /dev/null
+++ b/src/app/(backend)/webapi/agent/avatar/[id]/route.ts
@@ -0,0 +1,46 @@
+import { eq } from 'drizzle-orm';
+
+import { agents } from '@/database/schemas';
+import { serverDB } from '@/database/server';
+
+import { renderAgentAvatarPng } from './renderAgentAvatarPng';
+
+type Params = Promise<{ id: string }>;
+
+/**
+ * One agent's avatar as a png.
+ *
+ * Bark hands `icon` to iOS, which fetches and decodes it itself — a webp the
+ * browser shows happily is invisible on a lock screen, and an emoji has no URL
+ * to fetch. This flattens both into a png so the push carries the agent's own
+ * mark instead of Bark's. Unauthenticated like the user-avatar route: it
+ * exposes an avatar, which the inbox already shows to anyone who can see the
+ * agent.
+ */
+export const GET = async (_req: Request, segmentData: { params: Params }) => {
+  try {
+    const { id } = await segmentData.params;
+
+    const rows = await serverDB
+      .select({ avatar: agents.avatar })
+      .from(agents)
+      .where(eq(agents.id, id))
+      .limit(1);
+
+    if (!rows[0]) return new Response('Avatar not found', { status: 404 });
+
+    const png = await renderAgentAvatarPng(id, rows[0].avatar);
+
+    return new Response(new Uint8Array(png), {
+      headers: {
+        'Cache-Control': 'public, max-age=86400',
+        'Content-Type': 'image/png',
+      },
+      status: 200,
+    });
+  } catch (error) {
+    console.error('Error rendering agent avatar:', error);
+
+    return new Response('Internal server error', { status: 500 });
+  }
+};
