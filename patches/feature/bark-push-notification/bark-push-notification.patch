+      title: 'Agent run finished',
+      url: 'https://app.example.com/agent/a1/t1',
+    });
+    expect(mockCreateDelivery).toHaveBeenCalledWith(
+      expect.objectContaining({
+        channel: 'push',
+        notificationId: 'n1',
+        providerMessageId: '1700',
+        sentAt: expect.any(Date),
+        status: 'delivered',
+      }),
+    );
+  });
+
+  it('skips both the row and the push when the dedupe key already sent', async () => {
+    process.env.BARK_KEY = 'my-key';
+    const fetchMock = vi.fn().mockResolvedValue(okResponse());
+    vi.stubGlobal('fetch', fetchMock);
+    mockCreate.mockResolvedValue(null);
+
+    const { notifyUser } = await load();
+
+    await notifyUser(baseParams);
+
+    expect(fetchMock).not.toHaveBeenCalled();
+    expect(mockCreateDelivery).not.toHaveBeenCalled();
+  });
+
+  it('skips the push when the user muted this scenario', async () => {
+    process.env.BARK_KEY = 'my-key';
+    const fetchMock = vi.fn().mockResolvedValue(okResponse());
+    vi.stubGlobal('fetch', fetchMock);
+    mockGetUserSettings.mockResolvedValue({
+      notification: { push: { items: { agent: { agent_run_completed: false } } } },
+    });
+
+    const { notifyUser } = await load();
+
+    await notifyUser(baseParams);
+
+    expect(mockCreate).toHaveBeenCalled();
+    expect(fetchMock).not.toHaveBeenCalled();
+  });
+
+  it('gates the push on the workspace-merged preference', async () => {
+    process.env.BARK_KEY = 'my-key';
+    const fetchMock = vi.fn().mockResolvedValue(okResponse());
+    vi.stubGlobal('fetch', fetchMock);
+    mockGetUserSettings.mockResolvedValue({
+      notification: { push: { items: { agent: { agent_run_completed: false } } } },
+    });
+    mockGetPreference.mockResolvedValue({
+      notification: { push: { items: { agent: { agent_run_completed: true } } } },
+    });
+
+    const { notifyUser } = await load();
+
+    await notifyUser({ ...baseParams, workspaceId: 'w1' });
+
+    expect(fetchMock).toHaveBeenCalledTimes(1);
+  });
+
+  it('keeps another user’s notifications off the configured device', async () => {
+    process.env.BARK_KEY = 'my-key';
+    process.env.BARK_USER_ID = 'owner';
+    const fetchMock = vi.fn().mockResolvedValue(okResponse());
+    vi.stubGlobal('fetch', fetchMock);
+
+    const { notifyUser } = await load();
+
+    await notifyUser(baseParams);
+
+    expect(fetchMock).not.toHaveBeenCalled();
+  });
+
+  it('records a failed delivery row when the relay rejects the push', async () => {
+    process.env.BARK_KEY = 'my-key';
+    vi.stubGlobal('fetch', vi.fn().mockResolvedValue({ json: vi.fn(), ok: false, status: 500 }));
+
+    const { notifyUser } = await load();
+
+    await notifyUser(baseParams);
+
+    expect(mockCreateDelivery).toHaveBeenCalledWith(
+      expect.objectContaining({
+        channel: 'push',
+        failedReason: 'http_500',
+        sentAt: expect.any(Date),
+        status: 'failed',
+      }),
+    );
+  });
+
+  it('keeps the inbox row but skips the push when asked', async () => {
+    process.env.BARK_KEY = 'my-key';
+    const fetchMock = vi.fn().mockResolvedValue(okResponse());
+    vi.stubGlobal('fetch', fetchMock);
+
+    const { notifyUser } = await load();
+
+    await notifyUser(baseParams, { skipPush: true });
+
+    expect(mockCreate).toHaveBeenCalled();
+    expect(fetchMock).not.toHaveBeenCalled();
+    expect(mockCreateDelivery).not.toHaveBeenCalled();
+  });
+
+  it('re-throws a persistence failure when the caller needs it to be retryable', async () => {
+    mockCreate.mockRejectedValue(new Error('db down'));
+
+    const { notifyUser } = await load();
+
+    await expect(notifyUser(baseParams, { fatalOnPersistenceError: true })).rejects.toThrow(
+      'db down',
+    );
+  });
+
+  it('swallows a failure that happens after the row is durable', async () => {
+    process.env.BARK_KEY = 'my-key';
+    vi.stubGlobal('fetch', vi.fn().mockResolvedValue(okResponse()));
+    mockCreateDelivery.mockRejectedValue(new Error('delivery row failed'));
+
+    const { notifyUser } = await load();
+
+    // The row exists by now, so the recall is not lost — the caller must not
+    // retry the whole operation just because the audit row failed.
+    await expect(
+      notifyUser(baseParams, { fatalOnPersistenceError: true }),
+    ).resolves.toBeUndefined();
+    expect(console.error).toHaveBeenCalled();
+  });
+
+  it('swallows a database outage instead of failing the caller', async () => {
+    mockGetServerDB.mockRejectedValue(new Error('db down'));
+
+    const { notifyUser } = await load();
+
+    await expect(notifyUser(baseParams)).resolves.toBeUndefined();
+    expect(console.error).toHaveBeenCalled();
+  });
+});
+
+describe('notifyUser push presentation', () => {
+  const pushBody = (fetchMock: ReturnType<typeof vi.fn>) =>
+    JSON.parse(fetchMock.mock.calls[0][1].body);
+
+  // Sibling of the block above rather than nested in it, so it needs its own
+  // setup: without the DB stubs `create` resolves to undefined and notifyUser
+  // returns before it ever reaches the push.
+  beforeEach(() => {
+    vi.clearAllMocks();
+    for (const key of BARK_ENV_KEYS) delete process.env[key];
+    process.env.BARK_KEY = 'my-key';
+    mockAppUrl.value = 'https://app.example.com';
+    mockGetServerDB.mockResolvedValue({});
+    mockGetUserSettings.mockResolvedValue(undefined);
+    mockGetPreference.mockResolvedValue({});
+    mockGetAgentAvatarsByIds.mockResolvedValue([]);
+    mockCreate.mockResolvedValue({ id: 'n1' });
+    mockCreateDelivery.mockResolvedValue({ id: 'd1' });
+    vi.spyOn(console, 'error').mockImplementation(() => {});
+    vi.spyOn(console, 'warn').mockImplementation(() => {});
+  });
+
+  afterEach(() => {
+    vi.unstubAllGlobals();
+    vi.restoreAllMocks();
+  });
+
+  it('sends the agent avatar as the icon and its name as the collapse group', async () => {
+    const fetchMock = vi.fn().mockResolvedValue(okResponse());
+    vi.stubGlobal('fetch', fetchMock);
+    mockGetAgentAvatarsByIds.mockResolvedValue([
+      { avatar: 'https://cdn.example.com/a1.png', id: 'a1', name: 'Researcher', title: null },
+    ]);
+
+    const { notifyUser } = await load();
+
+    await notifyUser({ ...baseParams, actionUrl: '/agent/a1/t1' });
+
+    // The row only carries `agent.id`; a push has no client to resolve it, so
+    // the avatar has to be looked up here.
+    expect(mockGetAgentAvatarsByIds).toHaveBeenCalledWith(['a1']);
+    expect(pushBody(fetchMock)).toMatchObject({
+      group: 'Researcher',
+      icon: 'https://cdn.example.com/a1.png',
+    });
+  });
+
+  it('drops an emoji avatar rather than sending it as a broken icon', async () => {
+    const fetchMock = vi.fn().mockResolvedValue(okResponse());
+    vi.stubGlobal('fetch', fetchMock);
+    mockGetAgentAvatarsByIds.mockResolvedValue([
+      { avatar: '🤖', id: 'a1', name: 'Researcher', title: null },
+    ]);
+
+    const { notifyUser } = await load();
+
+    await notifyUser({ ...baseParams, actionUrl: '/agent/a1/t1' });
+
+    // APNs can only fetch a URL, so a common emoji avatar degrades the icon,
+    // not the notification.
+    expect(pushBody(fetchMock).icon).toBeUndefined();
+    expect(pushBody(fetchMock).group).toBe('Researcher');
+  });
+
+  it('falls back to a shared group when no agent can be resolved', async () => {
+    const fetchMock = vi.fn().mockResolvedValue(okResponse());
+    vi.stubGlobal('fetch', fetchMock);
+    mockGetAgentAvatarsByIds.mockResolvedValue([]);
+
+    const { notifyUser } = await load();
+
+    await notifyUser({ ...baseParams, actionUrl: '/agent/a1/t1' });
+
+    expect(pushBody(fetchMock).group).toBe('LobeHub');
+    expect(pushBody(fetchMock).icon).toBeUndefined();
+  });
+
+  it('still pushes when the agent lookup blows up', async () => {
+    const fetchMock = vi.fn().mockResolvedValue(okResponse());
+    vi.stubGlobal('fetch', fetchMock);
+    mockGetAgentAvatarsByIds.mockRejectedValue(new Error('db down'));
+
+    const { notifyUser } = await load();
+
+    await notifyUser({ ...baseParams, actionUrl: '/agent/a1/t1' });
+
+    expect(fetchMock).toHaveBeenCalledTimes(1);
+  });
+
+  it('carries the row context as the subtitle', async () => {
+    const fetchMock = vi.fn().mockResolvedValue(okResponse());
+    vi.stubGlobal('fetch', fetchMock);
+
+    const { notifyUser } = await load();
+
+    await notifyUser({ ...baseParams, context: 'T-1' });
+
+    expect(pushBody(fetchMock).subtitle).toBe('T-1');
+  });
+
+  it('rings persistently for a parked intervention', async () => {
+    const fetchMock = vi.fn().mockResolvedValue(okResponse());
+    vi.stubGlobal('fetch', fetchMock);
+
+    const { notifyUser } = await load();
+
+    await notifyUser({
+      ...baseParams,
+      category: 'agent',
+      type: 'agent_intervention_required',
+    });
+
+    // Someone has to answer before the run continues, so this one pierces
+    // silent mode and keeps sounding.
+    expect(pushBody(fetchMock)).toMatchObject({ call: 1, level: 'critical' });
+  });
+
+  it('escalates a scheduled failure through the interruption levels', async () => {
+    const fetchMock = vi.fn().mockResolvedValue(okResponse());
+    vi.stubGlobal('fetch', fetchMock);
+
+    const { notifyUser } = await load();
+
+    await notifyUser({ ...baseParams, category: 'schedule', type: 'agent_cron_job_failed' });
+    await notifyUser({
+      ...baseParams,
+      category: 'schedule',
+      type: 'agent_cron_job_failed_paused',
+    });
+    await notifyUser({ ...baseParams, category: 'generation', type: 'image_generation_completed' });
+
+    // A failed tick surfaces during Focus; a blown fuse that paused the task
+    // ignores silent mode because nothing will retry on its own; a generation
+    // the user is watching the canvas for just lands in the list.
+    expect(fetchMock.mock.calls.map((call) => JSON.parse(call[1].body).level)).toEqual([
+      'timeSensitive',
+      'critical',
+      'passive',
+    ]);
+  });
+});
