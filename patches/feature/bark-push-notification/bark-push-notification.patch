@@ -0,0 +1,45 @@
+// @vitest-environment node
+import { describe, expect, it } from 'vitest';
+
+import {
+  NOTIFICATION_CATEGORY,
+  NOTIFICATION_TYPE,
+} from '@/business/server/notification/categories';
+import notificationLocale from '@/locales/default/notification';
+
+/**
+ * The inbox renders one tab per category and labels it with `category.<value>`;
+ * `PERSONAL_INBOX_CATEGORIES` / `WORKSPACE_INBOX_CATEGORIES` live inside
+ * InboxModal and are not exported, so the vocabulary is mirrored here. A value
+ * outside it still renders — as an extra tab with a raw, untranslated label.
+ */
+const INBOX_CATEGORIES = [
+  'agent',
+  'billing',
+  'generation',
+  'mention',
+  'pending',
+  'schedule',
+  'system',
+  'workspace',
+];
+
+describe('notification taxonomy', () => {
+  it('only writes categories the inbox renders as a tab', () => {
+    for (const category of Object.values(NOTIFICATION_CATEGORY)) {
+      expect(INBOX_CATEGORIES).toContain(category);
+    }
+  });
+
+  it('only writes categories with a label', () => {
+    for (const category of Object.values(NOTIFICATION_CATEGORY)) {
+      expect(notificationLocale).toHaveProperty(`category.${category}`);
+    }
+  });
+
+  it('only writes types that already ship as notification copy', () => {
+    for (const type of Object.values(NOTIFICATION_TYPE)) {
+      expect(notificationLocale).toHaveProperty(`${type}_title`);
+    }
+  });
+});
