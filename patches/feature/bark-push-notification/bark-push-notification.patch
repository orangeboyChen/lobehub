@@ -0,0 +1,51 @@
+import { notifyUser } from '../notification';
+import { NOTIFICATION_CATEGORY, NOTIFICATION_TYPE } from '../notification/categories';
+import { renderCopy } from '../notification/copy';
+import { buildConversationPath, previewText, stripMarkdown } from '../notification/format';
+
+export interface NotifyAgentRunFailedParams {
+  agentId?: string;
+  /** Fallback label when the run carried no structured error type. */
+  errorMessage?: string;
+  /**
+   * Stable error taxonomy type (`network`, `quota`, `provider_outage`, …).
+   * Never the raw error text — that stays in briefs and logs.
+   */
+  errorType?: string;
+  operationId: string;
+  topicId?: string;
+  userId: string;
+  workspaceId?: string;
+}
+
+/**
+ * Tell the user a run they were waiting on did not make it.
+ *
+ * The success side is `notifyAgentRunCompleted`; this is its mirror for the
+ * `error` terminal. Only a genuine failure belongs here — a cancellation
+ * (`interrupted`) is the user's own doing, a run parked on `waiting_for_human`
+ * already has its own intervention notification, and `lease_expired` is an
+ * infrastructure timeout that would otherwise buzz the phone on every restart.
+ *
+ * The same recall gates apply as on completion: sub-agents, group members and
+ * share-visitor runs never reach this slot, and only interactive triggers
+ * (plain chat turns plus the two deferred ones) do.
+ */
+export async function notifyAgentRunFailed(params: NotifyAgentRunFailedParams): Promise<void> {
+  // A raw provider error can carry markdown, and it lands on a lock screen.
+  const error =
+    params.errorType || previewText(stripMarkdown(params.errorMessage ?? ''), 'unknown error', 120);
+
+  await notifyUser({
+    actionUrl: buildConversationPath({ agentId: params.agentId, topicId: params.topicId }),
+    category: NOTIFICATION_CATEGORY.agent,
+    content: renderCopy('agent_run_failed', { error }),
+    // Keyed by operation so a lifecycle retry cannot push the same failure twice.
+    dedupeKey: `agent_run_failed:${params.operationId}`,
+    metadata: params.agentId ? { agent: { id: params.agentId } } : undefined,
+    title: renderCopy('agent_run_failed_title'),
+    type: NOTIFICATION_TYPE.agentRunFailed,
+    userId: params.userId,
+    workspaceId: params.workspaceId,
+  });
+}
