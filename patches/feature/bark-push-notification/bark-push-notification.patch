+// @vitest-environment node
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+
+import { notifyAgentInterventionRequired } from '@/business/server/agent-run/agentInterventionReview';
+import { notifyAgentRunCompleted } from '@/business/server/agent-run/notifyAgentRunCompleted';
+import { notifyImageCompleted } from '@/business/server/image-generation/notifyImageCompleted';
+import {
+  notifyScheduledTaskCompleted,
+  notifyScheduledTaskFailed,
+} from '@/business/server/task/notifyScheduledTaskResult';
+import { notifyVideoCompleted } from '@/business/server/video-generation/notifyVideoCompleted';
+
+const { mockNotifyUser } = vi.hoisted(() => ({ mockNotifyUser: vi.fn() }));
+
+vi.mock('@/business/server/notification', () => ({ notifyUser: mockNotifyUser }));
+
+const lastCall = () => mockNotifyUser.mock.lastCall!;
+
+beforeEach(() => {
+  vi.clearAllMocks();
+  mockNotifyUser.mockResolvedValue(undefined);
+});
+
+describe('notifyAgentRunCompleted', () => {
+  it('recalls with the reply preview and a deep link into the conversation', async () => {
+    await notifyAgentRunCompleted({
+      agentId: 'a1',
+      lastAssistantContent: 'Here is the **summary**.',
+      operationId: 'op-1',
+      topicId: 't1',
+      userId: 'u1',
+    });
+
+    const [params] = lastCall();
+    expect(params).toMatchObject({
+      actionUrl: '/agent/a1/t1',
+      category: 'agent',
+      content: 'Here is the **summary**.',
+      dedupeKey: 'agent_run_completed:op-1',
+      metadata: { agent: { id: 'a1' } },
+      title: 'Agent task completed',
+      type: 'agent_run_completed',
+      userId: 'u1',
+    });
+  });
+
+  it('falls back to the title when the run produced no text', async () => {
+    await notifyAgentRunCompleted({ operationId: 'op-2', userId: 'u1' });
+
+    expect(lastCall()[0].content).toBe('Agent task completed');
+  });
+
+  // The floor is a code constant (MIN_PUSH_DURATION_MS) rather than a
+  // deployment knob: whether a run was short enough that the user was still
+  // watching is a product judgement, not something an operator configures.
+  it('keeps a run shorter than the floor off the phone', async () => {
+    await notifyAgentRunCompleted({ duration: 1_200, operationId: 'op-3', userId: 'u1' });
+
+    expect(lastCall()[1]).toEqual({ skipPush: true });
+  });
+
+  it('pushes a run that outlasts the floor', async () => {
+    await notifyAgentRunCompleted({ duration: 120_000, operationId: 'op-4', userId: 'u1' });
+
+    expect(lastCall()[1]).toEqual({ skipPush: false });
+  });
+});
+
+describe('notifyScheduledTaskResult', () => {
+  const base = {
+    agentId: 'a1',
+    operationId: 'op-1',
+    runTrigger: 'schedule' as const,
+    taskId: 'task-1',
+    taskIdentifier: 'T-1',
+    topicId: 't1',
+    userId: 'u1',
+  };
+
+  it('names the task in the completed copy', async () => {
+    await notifyScheduledTaskCompleted({
+      ...base,
+      lastAssistantContent: 'tick reply',
+      taskName: 'Nightly digest',
+    });
+
+    const [params] = lastCall();
+    expect(params).toMatchObject({
+      category: 'schedule',
+      content: 'Your scheduled task "Nightly digest" completed successfully.',
+      context: 'tick reply',
+      dedupeKey: 'scheduled_task_completed:op-1',
+      title: 'Scheduled task completed',
+      type: 'agent_cron_job_completed',
+    });
+  });
+
+  it('falls back to the task identifier when the task has no name', async () => {
+    await notifyScheduledTaskCompleted(base);
+
+    expect(lastCall()[0].content).toContain('"T-1"');
+  });
+
+  it('caps a runaway task name', async () => {
+    await notifyScheduledTaskCompleted({ ...base, taskName: 'x'.repeat(500) });
+
+    expect(lastCall()[0].content.length).toBeLessThan(140);
+  });
+
+  it('reports a tick failure with its structured error code', async () => {
+    await notifyScheduledTaskFailed({ ...base, errorCode: 'InsufficientBudgetForModel' });
+
+    const [params] = lastCall();
+    expect(params).toMatchObject({
+      context: 'InsufficientBudgetForModel',
+      dedupeKey: 'scheduled_task_failed:op-1',
+      title: 'Scheduled task failed',
+      type: 'agent_cron_job_failed',
+    });
+  });
+
+  it('reports a fuse stop as its own scenario', async () => {
+    await notifyScheduledTaskFailed({ ...base, consecutiveFailures: 3, paused: true });
+
+    const [params] = lastCall();
+    expect(params).toMatchObject({
+      content: expect.stringContaining('3 consecutive failures'),
+      title: 'Scheduled task paused',
+      type: 'agent_cron_job_failed_paused',
+    });
+  });
+});
+
+describe('generation notifications', () => {
+  it('names the prompt in the image copy', async () => {
+    await notifyImageCompleted({
+      duration: 10,
+      generationBatchId: 'b1',
+      model: 'dall-e-3',
+      prompt: 'a red panda',
+      userId: 'u1',
+    });
+
+    const [params] = lastCall();
+    expect(params).toMatchObject({
+      category: 'generation',
+      content: 'Your image "a red panda" is ready.',
+      context: 'dall-e-3',
+      dedupeKey: 'image_completed:b1',
+      title: 'Image generation completed',
+      type: 'image_generation_completed',
+    });
+  });
+
+  it('does not ship an empty prompt', async () => {
+    await notifyVideoCompleted({
+      generationBatchId: 'b3',
+      model: 'sora',
+      prompt: '   ',
+      userId: 'u1',
+    });
+
+    expect(lastCall()[0].content).toBe('Video generation completed');
+  });
+
+  it('names the prompt in the video copy', async () => {
+    await notifyVideoCompleted({
+      generationBatchId: 'b2',
+      model: 'sora',
+      prompt: 'a red panda',
+      userId: 'u1',
+    });
+
+    const [params] = lastCall();
+    expect(params).toMatchObject({
+      category: 'generation',
+      content: 'Your video "a red panda" is ready.',
+      dedupeKey: 'video_completed:b2',
+      type: 'video_generation_completed',
+    });
+  });
+});
+
+describe('notifyAgentInterventionRequired', () => {
+  const params = {
+    approvalMode: 'manual' as const,
+    batch: {
+      activityKey: 'activity-1',
+      allowedActions: [],
+      id: 'batch-1',
+      kind: 'single' as const,
+      sealed: true as const,
+      stepIndex: 0,
+    },
+    context: { agentId: 'a1', operationId: 'op-1', topicId: 't1' },
+    items: [],
+    summary: 'Approve running rm -rf?',
+    systemActionEligibility: 'review_only' as const,
+    userId: 'u1',
+  };
+
+  it('asks for review and deep-links into the parked run', async () => {
+    await notifyAgentInterventionRequired(params);
+
+    const [payload] = lastCall();
+    expect(payload).toMatchObject({
+      actionUrl: '/agent/a1/t1',
+      category: 'agent',
+      content: 'Agent needs your input: Approve running rm -rf?',
+      dedupeKey: 'agent_intervention_required:batch-1',
+      title: 'Agent needs your review',
+      type: 'agent_intervention_required',
+    });
+  });
+
+  it('makes a lost inbox row retryable for the parked lifecycle', async () => {
+    await notifyAgentInterventionRequired(params);
+
+    expect(lastCall()[1]).toEqual({ fatalOnPersistenceError: true });
+  });
+});
