+/**
+ * `(category, type)` pairs used for inbox grouping and for the per-scenario
+ * switches under `notification.push.items[category][type]`.
+ *
+ * Neither value is free to choose:
+ *
+ * - **category** — the inbox renders one tab per category from
+ *   `PERSONAL_INBOX_CATEGORIES` / `WORKSPACE_INBOX_CATEGORIES` and labels it
+ *   with the `category.<value>` locale key, so a value outside that vocabulary
+ *   shows up as an untranslated extra tab.
+ * - **type** — matches the notification keys already shipped in
+ *   `packages/locales/src/default/notification.ts` (and the inbox's icon map),
+ *   so these rows render — and later localise — like their Cloud equivalents.
+ */
+export const NOTIFICATION_CATEGORY = {
+  agent: 'agent',
+  generation: 'generation',
+  schedule: 'schedule',
+} as const;
+
+export const NOTIFICATION_TYPE = {
+  agentRunCompleted: 'agent_run_completed',
+  agentRunFailed: 'agent_run_failed',
+  cronJobCompleted: 'agent_cron_job_completed',
+  cronJobFailed: 'agent_cron_job_failed',
+  cronJobFailedPaused: 'agent_cron_job_failed_paused',
+  imageGenerationCompleted: 'image_generation_completed',
+  interventionRequired: 'agent_intervention_required',
+  videoGenerationCompleted: 'video_generation_completed',
+} as const;
