+/**
+ * Recall the user when a run finishes while they may be away.
+ *
+ * `CompletionLifecycle` decides who is worth recalling: sub-agents, group
+ * members and share-visitor runs never reach this slot, and only the
+ * recallable triggers do — plain chat turns plus the two deferred ones
+ * (`scheduled` and `cron`), which are exactly the "user walked away
+ * mid-conversation" cases.
+ *
+ * `scheduled` and `cron` here are *chat* triggers — a turn the user deferred
+ * and a rate-limit auto-resume — not automation task ticks. Task runs go
+ * through the task runner under its own trigger (`task`), which
+ * `CompletionLifecycle` explicitly does not recall, and are notified by
+ * `notifyScheduledTaskCompleted` instead. The two slots therefore never fire
+ * for the same operation.
+ *
+ * Every completion pushes, however short the run was. An earlier revision held
+ * back runs under 30s on the theory that the user was still watching the screen,
+ * but a short reply is the common case, so the feature looked dead — and the
+ * only trace was a debug log. Muting a scenario is the user's own switch in the
+ * notification settings, not the server's guess about elapsed time.
+ */
 export async function notifyAgentRunCompleted(
-  _params: NotifyAgentRunCompletedParams,
-): Promise<void> {}
+  params: NotifyAgentRunCompletedParams,
+): Promise<void> {
+  const title = renderCopy('agent_run_completed_title');
+  const preview = previewText(params.lastAssistantContent, title);
+
+  await notifyUser({
+    actionUrl: buildConversationPath({ agentId: params.agentId, topicId: params.topicId }),
+    category: NOTIFICATION_CATEGORY.agent,
+    content: renderCopy('agent_run_completed', { preview }),
+    // Keyed by operation so a lifecycle retry cannot push the same reply twice.
+    dedupeKey: `agent_run_completed:${params.operationId}`,
+    metadata: params.agentId ? { agent: { id: params.agentId } } : undefined,
+    title,
+    type: NOTIFICATION_TYPE.agentRunCompleted,
+    userId: params.userId,
+    workspaceId: params.workspaceId,
+  });
+}
