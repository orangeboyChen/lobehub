new file mode 100644
index 0000000000..9ab7ec0c5e
--- /dev/null
+++ b/packages/env/src/notification.ts
@@ -0,0 +1,49 @@
+import { createEnv } from '@t3-oss/env-core';
+import { z } from 'zod';
+
+declare global {
+  // eslint-disable-next-line @typescript-eslint/no-namespace
+  namespace NodeJS {
+    interface ProcessEnv {
+      BARK_KEY?: string;
+      BARK_SERVER_URL?: string;
+      BARK_USER_ID?: string;
+    }
+  }
+}
+
+/**
+ * Outbound push configuration for self-hosted deployments.
+ *
+ * The OSS notification slots are no-ops by default (Cloud overrides them with
+ * its own multi-channel service). Setting `BARK_KEY` gives a self-hosted
+ * instance a working push channel without Expo/APNs credentials: Bark is an
+ * iOS app that exposes an HTTP endpoint and relays the message to APNs itself.
+ *
+ * Only the device has to be configured here. Everything about *how* a
+ * notification looks — interruption level, collapse group, icon — is a product
+ * decision made in `packages/business-server/src/notification`, not a
+ * deployment knob.
+ */
+export const getNotificationConfig = () => {
+  return createEnv({
+    server: {
+      /** Bark device key — the path segment of `https://api.day.app/<key>`. */
+      BARK_KEY: z.string().optional(),
+      /** Self-hosted Bark server. Defaults to the public Bark service. */
+      BARK_SERVER_URL: z.string().optional(),
+      /**
+       * Restricts delivery to a single user id. A self-hosted instance is often
+       * shared by several accounts while one person owns the phone — shipping
+       * everyone's notifications to that one device would leak other users'
+       * activity, so set this unless the instance really is single-user.
+       */
+      BARK_USER_ID: z.string().optional(),
+    },
+    runtimeEnv: {
+      BARK_KEY: process.env.BARK_KEY,
+      BARK_SERVER_URL: process.env.BARK_SERVER_URL,
+      BARK_USER_ID: process.env.BARK_USER_ID,
+    },
+  });
+};
