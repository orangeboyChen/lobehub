+// @vitest-environment node
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+
+const { mockGetUserSettings, mockGetPreference } = vi.hoisted(() => ({
+  mockGetPreference: vi.fn(),
+  mockGetUserSettings: vi.fn(),
+}));
+
+vi.mock('@/database/models/user', () => ({
+  UserModel: vi.fn(function () {
+    return { getUserSettings: mockGetUserSettings };
+  }),
+}));
+
+vi.mock('@/database/models/workspaceUserSettings', () => ({
+  WorkspaceUserSettingsModel: vi.fn(function () {
+    return { getPreference: mockGetPreference };
+  }),
+}));
+
+const load = () => import('@/business/server/notification/settings');
+
+const db = {} as any;
+
+describe('resolvePushEnabled', () => {
+  beforeEach(() => {
+    vi.clearAllMocks();
+    mockGetUserSettings.mockResolvedValue(undefined);
+    mockGetPreference.mockResolvedValue({});
+  });
+
+  it('defaults to enabled when the user never touched the settings', async () => {
+    const { resolvePushEnabled } = await load();
+
+    await expect(
+      resolvePushEnabled(db, { category: 'agent', type: 'agent_run_completed', userId: 'u1' }),
+    ).resolves.toBe(true);
+  });
+
+  it('honours an explicit channel switch', async () => {
+    mockGetUserSettings.mockResolvedValue({ notification: { push: { enabled: false } } });
+    const { resolvePushEnabled } = await load();
+
+    await expect(
+      resolvePushEnabled(db, { category: 'agent', type: 'agent_run_completed', userId: 'u1' }),
+    ).resolves.toBe(false);
+  });
+
+  it('honours a per-scenario switch', async () => {
+    mockGetUserSettings.mockResolvedValue({
+      notification: { push: { items: { schedule: { agent_cron_job_completed: false } } } },
+    });
+    const { resolvePushEnabled } = await load();
+
+    await expect(
+      resolvePushEnabled(db, {
+        category: 'schedule',
+        type: 'agent_cron_job_completed',
+        userId: 'u1',
+      }),
+    ).resolves.toBe(false);
+
+    await expect(
+      resolvePushEnabled(db, { category: 'schedule', type: 'agent_cron_job_failed', userId: 'u1' }),
+    ).resolves.toBe(true);
+  });
+
+  it('lets a workspace override re-enable a scenario the personal bag muted', async () => {
+    mockGetUserSettings.mockResolvedValue({
+      notification: { push: { items: { schedule: { agent_cron_job_completed: false } } } },
+    });
+    mockGetPreference.mockResolvedValue({
+      notification: { push: { items: { schedule: { agent_cron_job_completed: true } } } },
+    });
+    const { resolvePushEnabled } = await load();
+
+    await expect(
+      resolvePushEnabled(db, {
+        category: 'task',
+        type: 'completed',
+        userId: 'u1',
+        workspaceId: 'w1',
+      }),
+    ).resolves.toBe(true);
+  });
+
+  it('does not read workspace preferences for personal notifications', async () => {
+    mockGetUserSettings.mockResolvedValue({ notification: { push: { enabled: true } } });
+    const { resolvePushEnabled } = await load();
+
+    await resolvePushEnabled(db, {
+      category: 'agent_run',
+      type: 'completed',
+      userId: 'u1',
+      workspaceId: null,
+    });
+
+    expect(mockGetPreference).not.toHaveBeenCalled();
+  });
+});
diff --git a/apps/server/src/services/notification/__tests__/slots.test.ts b/apps/server/src/services/notification/__tests__/slots.test.ts
