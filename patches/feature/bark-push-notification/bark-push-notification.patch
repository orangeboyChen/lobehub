--- /dev/null
+++ b/packages/business-server/src/notification/agentMeta.ts
@@ -0,0 +1,58 @@
+import { AgentModel } from '@/database/models/agent';
+import type { LobeChatDatabase } from '@/database/type';
+
+/**
+ * Everything a push payload needs to know about the agent behind it.
+ *
+ * Inbox rows only carry `metadata.agent.id` because a client resolves the
+ * avatar from its live store (`useNotificationAgentMeta`). A push has no
+ * client: Bark has to be handed a URL, so the row's id is resolved here.
+ */
+export interface AgentPushMeta {
+  /** Absolute image URL, or undefined — Bark cannot use an emoji avatar. */
+  iconUrl?: string;
+  /** Collapse key for Bark's `group`: same agent, one stack on the phone. */
+  name?: string;
+}
+
+/** Agent avatars are free text: http(s) URLs, emojis, and data URIs all occur. */
+const isFetchableUrl = (value: string): boolean => {
+  try {
+    const { protocol } = new URL(value);
+
+    return protocol === 'http:' || protocol === 'https:';
+  } catch {
+    return false;
+  }
+};
+
+/**
+ * Resolve the agent behind a notification, never throwing.
+ *
+ * A missing or unreadable agent degrades the push (no icon, no group) — it
+ * must not cost the notification, and it must not cost the caller's run.
+ */
+export const resolveAgentPushMeta = async (
+  db: LobeChatDatabase,
+  userId: string,
+  agentId?: string,
+): Promise<AgentPushMeta> => {
+  if (!agentId) return {};
+
+  try {
+    const [agent] = await new AgentModel(db, userId).getAgentAvatarsByIds([agentId]);
+    if (!agent) return {};
+
+    const label = agent.name || agent.title || undefined;
+    const avatar = agent.avatar?.trim();
+
+    return {
+      // An emoji avatar is common and APNs cannot fetch it, so it is dropped
+      // rather than sent as a broken icon URL.
+      iconUrl: avatar && isFetchableUrl(avatar) ? avatar : undefined,
+      name: label,
+    };
+  } catch {
+    return {};
+  }
+};
diff --git a/packages/business-server/src/notification/bark.ts b/packages/business-server/src/notification/bark.ts
new file mode 100644
index 0000000000..7080f61f70
--- /dev/null
+++ b/packages/business-server/src/notification/bark.ts
@@ -0,0 +1,142 @@
+import { pushConfig } from './config';
+import type { BarkLevel } from './levels';
+
+/** Public Bark relay used when `BARK_SERVER_URL` is not set. */
+const DEFAULT_BARK_SERVER_URL = 'https://api.day.app';
+
+/**
+ * Bark is a best-effort side channel, and two callers await this slot inside a
+ * persistence path — a dead relay must not add a long stall to either.
+ */
+const REQUEST_TIMEOUT_MS = 5_000;
+
+/** Emitted once per process: the operator needs to know their phone is shared. */
+let warnedAboutSharedDevice = false;
+
+export interface BarkMessage {
+  body: string;
+  /** Bark's `call`: play the sound repeatedly for 30s. For "answer me now". */
+  call?: boolean;
+  /** Collapse key — pushes sharing a group stack together on the phone. */
+  group?: string;
+  /** iOS 15+: APNs fetches this and renders it as the notification icon. */
+  icon?: string;
+  /** Interruption level; drives screen wake, Focus and silent mode. */
+  level?: BarkLevel;
+  /** Secondary line under the title. */
+  subtitle?: string;
+  title: string;
+  /** Opened when the notification is tapped. */
+  url?: string;
+}
+
+export interface BarkDeliveryResult {
+  failedReason?: string;
+  /** Bark echoes a timestamp for accepted pushes; good enough for tracing. */
+  providerMessageId?: string;
+  status: 'delivered' | 'failed';
+}
+
+/**
+ * Normalised relay origin, or `undefined` when the configured value is not an
+ * http(s) URL — the device key is appended to this, and the URL is
+ * operator-supplied, so anything else is refused rather than fetched.
+ */
+const serverUrl = (): string | undefined => {
+  const configured = pushConfig().BARK_SERVER_URL?.trim() || DEFAULT_BARK_SERVER_URL;
+
+  try {
+    const url = new URL(configured);
+    if (url.protocol !== 'http:' && url.protocol !== 'https:') return undefined;
+
+    return `${url.origin}${url.pathname.replace(/\/+$/, '')}`;
+  } catch {
+    return undefined;
+  }
+};
+
+/** Whether this deployment has a push channel at all. */
+export const isBarkConfigured = (): boolean => Boolean(pushConfig().BARK_KEY?.trim());
+
+/**
+ * Whether `userId` owns the configured device.
+ *
+ * An unset `BARK_USER_ID` means "single-user instance", so every user is
+ * accepted — on a shared instance that ships other people's replies and prompts
+ * to this one phone, so warn once instead of failing silently.
+ */
+export const isBarkRecipient = (userId: string): boolean => {
+  const ownerId = pushConfig().BARK_USER_ID?.trim();
+
+  if (!ownerId) {
+    if (!warnedAboutSharedDevice) {
+      warnedAboutSharedDevice = true;
+      console.warn(
+        "[notification] BARK_KEY is set without BARK_USER_ID — every user's notifications will be pushed to this device. Set BARK_USER_ID unless this instance is single-user.",
+      );
+    }
+
+    return true;
+  }
+
+  return ownerId === userId;
+};
+
+/**
+ * Deliver one message through Bark.
+ *
+ * Never throws: notification delivery is fire-and-forget, and a dead relay must
+ * not surface as a failed agent run.
+ */
+export const sendBarkNotification = async (message: BarkMessage): Promise<BarkDeliveryResult> => {
+  const key = pushConfig().BARK_KEY?.trim();
+
+  if (!key) return { failedReason: 'bark_not_configured', status: 'failed' };
+
+  const base = serverUrl();
+  if (!base) return { failedReason: 'invalid_server_url', status: 'failed' };
+
+  try {
+    const response = await fetch(`${base}/${encodeURIComponent(key)}`, {
+      // `JSON.stringify` drops the absent optional fields, so Bark only sees
+      // the hints this message actually set.
+      body: JSON.stringify({
+        body: message.body,
+        call: message.call ? 1 : undefined,
+        group: message.group,
+        icon: message.icon,
+        level: message.level,
+        subtitle: message.subtitle,
+        title: message.title,
+        url: message.url,
+      }),
+      headers: { 'Content-Type': 'application/json' },
+      method: 'POST',
+      signal: AbortSignal.timeout(REQUEST_TIMEOUT_MS),
+    });
+
+    if (!response.ok) return { failedReason: `http_${response.status}`, status: 'failed' };
+
+    // Bark replies 200 with a JSON body whose `code` is the real outcome; a
+    // non-JSON body is treated as success because the HTTP status already said
+    // the relay accepted the push.
+    const payload = (await response.json().catch(() => null)) as {
+      code?: number;
+      timestamp?: number;
+    } | null;
+
+    if (payload?.code !== undefined && payload.code !== 200) {
+      return { failedReason: `bark_${payload.code}`, status: 'failed' };
+    }
+
+    return {
+      providerMessageId: payload?.timestamp ? String(payload.timestamp) : undefined,
+      status: 'delivered',
+    };
+  } catch (error) {
+    return {
+      failedReason: error instanceof Error ? error.name : 'unknown',
+      status: 'failed',
+    };
+  }
+};
