diff --git a/apps/server/src/services/notification/__tests__/bark.test.ts b/apps/server/src/services/notification/__tests__/bark.test.ts
new file mode 100644
index 0000000000..33e8c4be99
--- /dev/null
+++ b/apps/server/src/services/notification/__tests__/bark.test.ts
@@ -0,0 +1,257 @@
+// @vitest-environment node
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+
+const ENV_KEYS = ['BARK_KEY', 'BARK_SERVER_URL', 'BARK_USER_ID'];
+
+const jsonResponse = (payload: unknown, status = 200) => ({
+  json: vi.fn().mockResolvedValue(payload),
+  ok: status >= 200 && status < 300,
+  status,
+});
+
+const load = () => import('@/business/server/notification/bark');
+
+// Each test gets a fresh module so per-process state (the shared-device warning)
+// cannot leak between cases.
+beforeEach(() => {
+  vi.resetModules();
+  for (const key of ENV_KEYS) delete process.env[key];
+  vi.spyOn(console, 'warn').mockImplementation(() => {});
+});
+
+afterEach(() => {
+  vi.unstubAllGlobals();
+  vi.restoreAllMocks();
+});
+
+describe('sendBarkNotification', () => {
+  it('fails without touching the network when no key is configured', async () => {
+    const fetchMock = vi.fn();
+    vi.stubGlobal('fetch', fetchMock);
+
+    const { sendBarkNotification } = await load();
+    const result = await sendBarkNotification({ body: 'body', title: 'title' });
+
+    expect(result).toEqual({ failedReason: 'bark_not_configured', status: 'failed' });
+    expect(fetchMock).not.toHaveBeenCalled();
+  });
+
+  it('posts to the default relay with the key in the path', async () => {
+    process.env.BARK_KEY = 'my-key';
+    const fetchMock = vi.fn().mockResolvedValue(jsonResponse({ code: 200, timestamp: 1700 }));
+    vi.stubGlobal('fetch', fetchMock);
+
+    const { sendBarkNotification } = await load();
+    const result = await sendBarkNotification({ body: 'body', title: 'title' });
+
+    expect(fetchMock).toHaveBeenCalledTimes(1);
+    const [url, init] = fetchMock.mock.calls[0];
+    expect(url).toBe('https://api.day.app/my-key');
+    expect(init.method).toBe('POST');
+    // Bark parses a JSON body, and the timeout is what keeps a dead relay from
+    // stalling the run that triggered the notification.
+    expect(init.headers).toMatchObject({ 'Content-Type': 'application/json' });
+    expect(init.signal).toBeInstanceOf(AbortSignal);
+    expect(JSON.parse(init.body)).toMatchObject({ body: 'body', title: 'title' });
+    expect(result).toEqual({ providerMessageId: '1700', status: 'delivered' });
+  });
+
+  it('uses a self-hosted relay and tolerates a trailing slash', async () => {
+    process.env.BARK_KEY = 'my-key';
+    process.env.BARK_SERVER_URL = 'https://bark.example.com/';
+    const fetchMock = vi.fn().mockResolvedValue(jsonResponse({ code: 200 }));
+    vi.stubGlobal('fetch', fetchMock);
+
+    const { sendBarkNotification } = await load();
+    await sendBarkNotification({ body: 'body', title: 'title' });
+
+    expect(fetchMock.mock.calls[0][0]).toBe('https://bark.example.com/my-key');
+  });
+
+  it('keeps a relay served from a sub-path', async () => {
+    process.env.BARK_KEY = 'my-key';
+    process.env.BARK_SERVER_URL = 'https://bark.example.com/push/';
+    const fetchMock = vi.fn().mockResolvedValue(jsonResponse({ code: 200 }));
+    vi.stubGlobal('fetch', fetchMock);
+
+    const { sendBarkNotification } = await load();
+    await sendBarkNotification({ body: 'body', title: 'title' });
+
+    expect(fetchMock.mock.calls[0][0]).toBe('https://bark.example.com/push/my-key');
+  });
+
+  it('forwards the deep link and the presentation hints the caller chose', async () => {
+    process.env.BARK_KEY = 'my-key';
+    const fetchMock = vi.fn().mockResolvedValue(jsonResponse({ code: 200 }));
+    vi.stubGlobal('fetch', fetchMock);
+
+    const { sendBarkNotification } = await load();
+    await sendBarkNotification({
+      body: 'body',
+      group: 'Researcher',
+      icon: 'https://cdn.example.com/a1.png',
+      level: 'timeSensitive',
+      subtitle: 'T-1',
+      title: 'title',
+      url: 'https://app.example.com/agent/a1/t1',
+    });
+
+    // Level and group are decided per scenario in code, not read from the
+    // environment — this asserts the payload carries what it was handed.
+    expect(JSON.parse(fetchMock.mock.calls[0][1].body)).toEqual({
+      body: 'body',
+      group: 'Researcher',
+      icon: 'https://cdn.example.com/a1.png',
+      level: 'timeSensitive',
+      subtitle: 'T-1',
+      title: 'title',
+      url: 'https://app.example.com/agent/a1/t1',
+    });
+  });
+
+  it('sends a call as Bark’s 1 and omits the hints a message did not set', async () => {
+    process.env.BARK_KEY = 'my-key';
+    const fetchMock = vi.fn().mockResolvedValue(jsonResponse({ code: 200 }));
+    vi.stubGlobal('fetch', fetchMock);
+
+    const { sendBarkNotification } = await load();
+    await sendBarkNotification({ body: 'body', call: true, level: 'critical', title: 'title' });
+
+    // Absent optional fields must not reach Bark as nulls, or it would fall
+    // back to its own defaults instead of the caller's omissions.
+    expect(JSON.parse(fetchMock.mock.calls[0][1].body)).toEqual({
+      body: 'body',
+      call: '1',
+      level: 'critical',
+      title: 'title',
+    });
+  });
+
+  it('reports an HTTP failure as failed', async () => {
+    process.env.BARK_KEY = 'my-key';
+    vi.stubGlobal('fetch', vi.fn().mockResolvedValue(jsonResponse({ code: 200 }, 500)));
+
+    const { sendBarkNotification } = await load();
+    const result = await sendBarkNotification({ body: 'body', title: 'title' });
+
+    expect(result).toEqual({ failedReason: 'http_500', status: 'failed' });
+  });
+
+  it('reports a non-200 Bark code as failed', async () => {
+    process.env.BARK_KEY = 'my-key';
+    vi.stubGlobal('fetch', vi.fn().mockResolvedValue(jsonResponse({ code: 400 })));
+
+    const { sendBarkNotification } = await load();
+    const result = await sendBarkNotification({ body: 'body', title: 'title' });
+
+    expect(result).toEqual({ failedReason: 'bark_400', status: 'failed' });
+  });
+
+  it('treats a non-JSON 200 body as delivered', async () => {
+    process.env.BARK_KEY = 'my-key';
+    vi.stubGlobal(
+      'fetch',
+      vi
+        .fn()
+        .mockResolvedValue({ json: vi.fn().mockRejectedValue(new Error('not json')), ok: true }),
+    );
+
+    const { sendBarkNotification } = await load();
+    const result = await sendBarkNotification({ body: 'body', title: 'title' });
+
+    expect(result).toEqual({ status: 'delivered' });
+  });
+
+  it('never throws when the relay is unreachable', async () => {
+    process.env.BARK_KEY = 'my-key';
+    vi.stubGlobal('fetch', vi.fn().mockRejectedValue(new TypeError('fetch failed')));
+
+    const { sendBarkNotification } = await load();
+    const result = await sendBarkNotification({ body: 'body', title: 'title' });
+
+    expect(result).toEqual({ failedReason: 'TypeError', status: 'failed' });
+  });
+});
+
+describe('isBarkConfigured', () => {
+  beforeEach(() => {
+    for (const key of ENV_KEYS) delete process.env[key];
+  });
+
+  it('is false without a key and true with one', async () => {
+    const { isBarkConfigured } = await load();
+    expect(isBarkConfigured()).toBe(false);
+
+    process.env.BARK_KEY = 'my-key';
+    expect(isBarkConfigured()).toBe(true);
+  });
+
+  it('treats a blank key as unconfigured', async () => {
+    process.env.BARK_KEY = '   ';
+    const { isBarkConfigured } = await load();
+    expect(isBarkConfigured()).toBe(false);
+  });
+});
+
+describe('isBarkRecipient', () => {
+  beforeEach(() => {
+    for (const key of ENV_KEYS) delete process.env[key];
+  });
+
+  it('accepts every user when no owner is pinned', async () => {
+    const { isBarkRecipient } = await load();
+    expect(isBarkRecipient('user-1')).toBe(true);
+    expect(isBarkRecipient('user-2')).toBe(true);
+  });
+
+  it('accepts only the pinned owner when one is set', async () => {
+    process.env.BARK_USER_ID = 'user-1';
+    const { isBarkRecipient } = await load();
+    expect(isBarkRecipient('user-1')).toBe(true);
+    expect(isBarkRecipient('user-2')).toBe(false);
+  });
+
+  it('warns once that the device is shared when no owner is pinned', async () => {
+    const { isBarkRecipient } = await load();
+
+    isBarkRecipient('user-1');
+    isBarkRecipient('user-2');
+
+    expect(console.warn).toHaveBeenCalledTimes(1);
+  });
+
+  it('does not warn when the recipient is pinned', async () => {
+    process.env.BARK_USER_ID = 'user-1';
+    const { isBarkRecipient } = await load();
+
+    isBarkRecipient('user-1');
+
+    expect(console.warn).not.toHaveBeenCalled();
+  });
+});
+
+describe('relay url handling', () => {
+  it('refuses a non-http relay instead of fetching it with the key attached', async () => {
+    process.env.BARK_KEY = 'my-key';
+    process.env.BARK_SERVER_URL = 'file:///etc/passwd';
+    const fetchMock = vi.fn();
+    vi.stubGlobal('fetch', fetchMock);
+
+    const { sendBarkNotification } = await load();
+    const result = await sendBarkNotification({ body: 'body', title: 'title' });
+
+    expect(result).toEqual({ failedReason: 'invalid_server_url', status: 'failed' });
+    expect(fetchMock).not.toHaveBeenCalled();
+  });
+
+  it('escapes a key that would otherwise change the request path', async () => {
+    process.env.BARK_KEY = 'a/b?c#d';
+    const fetchMock = vi.fn().mockResolvedValue(jsonResponse({ code: 200 }));
+    vi.stubGlobal('fetch', fetchMock);
+
+    const { sendBarkNotification } = await load();
+    await sendBarkNotification({ body: 'body', title: 'title' });
+
+    expect(fetchMock.mock.calls[0][0]).toBe('https://api.day.app/a%2Fb%3Fc%23d');
+  });
+});
diff --git a/apps/server/src/services/notification/__tests__/categories.test.ts b/apps/server/src/services/notification/__tests__/categories.test.ts
